default_platform(:ios)

platform :ios do
  desc "Archive and upload a build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    sh("../scripts/generate_secrets.sh")

    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s
    increment_build_number(
      xcodeproj: "Axis.xcodeproj",
      build_number: build_number
    )

    build_app(
      api_key: api_key,
      project: "Axis.xcodeproj",
      scheme: "Axis",
      configuration: "Release",
      export_method: "app-store",
      export_options: "ExportOptions.plist",
      output_directory: "build",
      output_name: "Axis.ipa",
      clean: true,
      xcargs: "-skipMacroValidation -allowProvisioningUpdates DEVELOPMENT_TEAM=Q62397NX22 CODE_SIGN_STYLE=Automatic"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
